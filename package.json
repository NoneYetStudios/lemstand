{
  "name": "lemonade-stand",
  "version": "1.0.0",
  "description": "Modern web recreation of the classic Apple ][e Lemonade Stand game with Retro, 8-bit, and Modern modes, strict family-friendly filtering, and SQLite leaderboards.",
  "main": "backend/server.js",
  "scripts": {
    "start": "node --no-warnings backend/server.js",
    "dev": "node --no-warnings --watch backend/server.js",
    "init-db": "node --no-warnings backend/scripts/initDb.js",
    "seed": "node --no-warnings backend/scripts/seedDb.js",
    "build:css": "tailwindcss -i frontend/css/tailwind-input.css -o frontend/css/tailwind.min.css --minify",
    "build": "node scripts/build.js",
    "test": "node --no-warnings tests/runTests.js"
  },
  "keywords": [
    "lemonade-stand",
    "apple-iie",
    "retro-game",
    "8-bit",
    "sqlite",
    "express"
  ],
  "author": "Lemonade Stand Team",
  "license": "MIT",
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.19"
  }
}
